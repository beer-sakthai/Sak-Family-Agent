{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sakthai.family/v1/cli-envelope.json",
  "title": "Sak CLI Output Envelope Schema v1",
  "type": "object",
  "required": ["schema", "ok", "data", "error", "warnings"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "sak.cli/v1"
    },
    "$schema": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {},
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "details": {}
      },
      "required": ["code", "message"]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
