{
  "phaseGates": {
    "strict": false
  },
  "autoVerification": {
    "enabled": true,
    "commands": {
      "python": "uv run ruff check && uv run pytest tests/test_repo_parses.py -q",
      "typescript": "pnpm typecheck"
    }
  },
  "security": {
    "gitCheckpoints": true,
    "controlCharValidation": true
  },
  "conductor": {
    "enabled": true,
    "path": "conductor"
  }
}
