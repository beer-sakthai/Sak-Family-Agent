{
  "_comment": "SakKing — Lead & Orchestrator; owns all skills/tools. Superset of every sibling's MCP servers. Load with SAKTHAI_MCP_CONFIG=personas/sakking/config/mcp.json.",
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.10.1"]
    },
    "hf-media": {
      "command": "npx",
      "args": [
        "-y",
        "@llmindset/mcp-hfspace@0.5.4",
        "black-forest-labs/FLUX.1-schnell",
        "Lightricks/LTX-Video"
      ]
    },
    "stepsecurity": {
      "url": "https://agent.api.stepsecurity.io/v1/mcp?customer=beer-sakthai",
      "headers": {
        "Authorization": "Bearer ${STEP_SECURITY_API_KEY}"
      }
    },
    "microsoft365": {
      "url": "https://microsoft365.mcp.claude.com/mcp",
      "headers": {
        "Authorization": "Bearer ${MS365_MCP_TOKEN}"
      },
      "tools": [
        "get_me",
        "search_people",
        "outlook_email_search",
        "outlook_calendar_search",
        "outlook_find_available_time",
        "find_meeting_availability",
        "sharepoint_search",
        "sharepoint_folder_search",
        "chat_message_search",
        "teams_list_teams",
        "teams_list_channels",
        "teams_list_channel_messages",
        "teams_list_chats"
      ]
    },
    "microsoft-learn": {
      "url": "https://learn.microsoft.com/api/mcp",
      "tools": [
        "microsoft_docs_search",
        "microsoft_code_sample_search",
        "microsoft_docs_fetch"
      ]
    },
    "gemini-api-docs": {
      "url": "https://gemini-api-docs-mcp.dev",
      "tools": [
        "gemini_search_docs",
        "gemini_get_doc"
      ]
    }
  }
}
