{
  "_comment": "SakSee — Master of Web. Load with SAKTHAI_MCP_CONFIG=personas/saksee/config/mcp.json. Tools surface namespaced as <server>__<tool>.",
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.10.1"]
    },
    "microsoft-learn": {
      "url": "https://learn.microsoft.com/api/mcp",
      "tools": [
        "microsoft_docs_search",
        "microsoft_code_sample_search",
        "microsoft_docs_fetch"
      ]
    },
    "gemini-api-docs": {
      "url": "https://gemini-api-docs-mcp.dev",
      "tools": [
        "gemini_search_docs",
        "gemini_get_doc"
      ]
    }
  }
}
