{
  "_comment": "SakThai — Master of Hugging Face. Load with SAKTHAI_MCP_CONFIG=personas/sakthai/config/mcp.json. Active streamable HTTP MCP servers: huggingface, gemini-api-docs, microsoft-learn.",
  "mcpServers": {
    "microsoft-learn": {
      "url": "https://learn.microsoft.com/api/mcp",
      "tools": [
        "microsoft_docs_search",
        "microsoft_code_sample_search",
        "microsoft_docs_fetch"
      ]
    },
    "gemini-api-docs": {
      "url": "https://gemini-api-docs-mcp.dev",
      "tools": [
        "gemini_search_docs",
        "gemini_get_doc"
      ]
    },
    "huggingface": {
      "url": "https://huggingface.co/api/mcp",
      "headers": {
        "Authorization": "Bearer ${HF_TOKEN}"
      },
      "tool_allowlist": [
        "hf_inspect_repo",
        "hf_portfolio_summary",
        "huggingface_inference"
      ],
      "tools": [
        "hf_inspect_repo",
        "hf_portfolio_summary",
        "huggingface_inference"
      ]
    }
  }
}
