{
  "_comment": "SakSit — Master of Social Media. Image/video generation via Hugging Face Spaces (mcp-hfspace). Swap the Space ids for your preferred models. Spawned servers do not inherit HF_TOKEN or any other host secret (docs/security-hardening.md, finding 2).",
  "mcpServers": {
    "hf-media": {
      "command": "npx",
      "args": [
        "-y",
        "@llmindset/mcp-hfspace@0.5.4",
        "black-forest-labs/FLUX.1-schnell",
        "Lightricks/LTX-Video"
      ]
    },
    "microsoft365": {
      "url": "https://microsoft365.mcp.claude.com/mcp",
      "headers": {
        "Authorization": "Bearer ${MS365_MCP_TOKEN}"
      },
      "tools": [
        "get_me",
        "search_people",
        "outlook_email_search",
        "outlook_calendar_search",
        "outlook_find_available_time",
        "find_meeting_availability",
        "sharepoint_search",
        "sharepoint_folder_search",
        "chat_message_search",
        "teams_list_teams",
        "teams_list_channels",
        "teams_list_channel_messages",
        "teams_list_chats"
      ]
    },
    "microsoft-learn": {
      "url": "https://learn.microsoft.com/api/mcp",
      "tools": [
        "microsoft_docs_search",
        "microsoft_code_sample_search",
        "microsoft_docs_fetch"
      ]
    }
  }
}
