# Copy to .env and fill in. Only ANTHROPIC_API_KEY is needed for `sakthai run`.

# Claude API key — used by `sakthai run`. You can instead sign in with the
# Claude CLI (`claude login`) and the agent will reuse that OAuth token.
ANTHROPIC_API_KEY=

# Optional: Bearer token alternative to ANTHROPIC_API_KEY.
# ANTHROPIC_AUTH_TOKEN=

# Optional: Gemini provider (alternative to Anthropic).
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Optional: override the data directory (default: ~/.sakthai).
# SAKTHAI_HOME=

# Optional: extra paths the read_file tool may read (os.pathsep-separated).
# SAKTHAI_READ_ALLOW=

# Optional: enable the send_telegram_message tool.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: enable the send_outlook_mail / read_outlook_mail /
# list_calendar_events / create_calendar_event tools (Microsoft Graph).
# Run `python scripts/graph_device_login.py` once to sign in and populate
# MS_GRAPH_REFRESH_TOKEN (also cached at ~/.sakthai/graph_token.json).
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_TENANT_ID=consumers
# MS_GRAPH_REFRESH_TOKEN=

# Optional: OpenAI-compatible provider credentials (--provider openai).
# OPENAI_API_KEY=

# Optional: base URL for an OpenAI-compatible endpoint (OPENAI_API_BASE or
# OPENAI_BASE_URL are both read; either name works).
# OPENAI_API_BASE=
# OPENAI_BASE_URL=

# Optional: Ollama server address (--provider ollama). Default: http://127.0.0.1:11434
# OLLAMA_HOST=

# Optional: AI gateway (OpenRouter/LiteLLM/Vercel/Cloudflare) base URL — enables
# the `gateway` provider (--provider gateway).
# SAKTHAI_GATEWAY_URL=

# Optional: bearer token for the AI gateway above. Default: nokey
# SAKTHAI_GATEWAY_API_KEY=

# Optional: OpenCode Zen / Go subscription key (https://opencode.ai/auth). Read by
# the `opencode` CLI for local runs, and by .github/workflows/opencode.yml in CI,
# where the same value lives as the OPENCODE_API_KEY repository secret.
# OPENCODE_API_KEY=

# Optional: any non-empty value enables the run_command (shell) tool.
# SAKTHAI_SHELL_ALLOW=

# Optional: seconds to wait for an external MCP server reply. Default: 30
# SAKTHAI_MCP_TIMEOUT=

# Optional: Telegram gateway (requires TELEGRAM_BOT_TOKEN above).
# Comma/space-separated user IDs allowed to use the bot. If empty, nobody can.
# TELEGRAM_ALLOWED_USER_IDS=

# Optional: launch overrides for Telegram/systemd runs (see `sakthai run --help`).
# SAKTHAI_PROVIDER=
# SAKTHAI_MODEL=
# SAKTHAI_FAST=
# SAKTHAI_NO_MCP=
# SAKTHAI_WITH_SKILLS=

# Optional: system prompt injection (prefix).
# SAKTHAI_SYSTEM_PROMPT=
# SAKTHAI_SYSTEM_PROMPT_FILE=

# Optional: data and config paths.
# SAKKING_HOME=
# SAKTHAI_EVAL_LOG=
# SAKTHAI_MCP_CONFIG=
