# Versions-only view of ml-stack-requirements.lock (no hashes — constraints
# files don't need them), so section 3's pip install in the Dockerfile
# resolves against what section 2 already installed instead of silently
# drifting. Regenerate after ml-stack-requirements.lock changes:
#   grep '^[a-z]' infra/sakthai-training-space/ml-stack-requirements.lock | sed 's/ \\$//' \
#     > infra/sakthai-training-space/ml-stack.constraints
