# Shared settings for every Sak Family agent. Copy to
# ~/.config/sak-family-agents/common.env and fill in.

# The published image the systemd unit pulls. Pin this to a digest rather than
# a moving tag — `.github/workflows/publish-image.yml` prints the digest to pin
# at the end of every run:
#   IMAGE_NAME=ghcr.io/beer-sakthai/sak-family-agent@sha256:<digest>
IMAGE_NAME=ghcr.io/beer-sakthai/sak-family-agent:latest

# Model provider. The deployed personas talk to Azure OpenAI through the
# OpenAI-compatible provider.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://sakthai-resource.openai.azure.com/openai/v1
SAKTHAI_PROVIDER=openai

# Telegram user IDs allowed to talk to any of the bots. Empty means nobody can.
TELEGRAM_ALLOWED_USER_IDS=123456789
