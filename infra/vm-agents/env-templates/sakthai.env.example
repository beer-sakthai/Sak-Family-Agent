# Per-agent settings for sakthai. Copy to
# ~/.config/sak-family-agents/sakthai.env and fill in the bot token.
#
# Deliberately NOT set here: SAKTHAI_HOME, SAKTHAI_PERSONA and
# SAKTHAI_SYSTEM_PROMPT_FILE. The systemd unit derives all three from the
# instance name (%i), and systemd applies EnvironmentFile *after* Environment=,
# so a value here would override the unit. Pointing two personas at one
# SAKTHAI_HOME silently merges their memory and cycle-stage state.

SAKTHAI_FAST=1
SAKTHAI_MODEL=gpt-4o-mini
SAKTHAI_WITH_SKILLS=

# This agent's own Telegram bot token — one per persona, never shared.
TELEGRAM_BOT_TOKEN=replace-me
