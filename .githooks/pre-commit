#!/bin/sh
#
# Pre-commit hook to ensure uv.lock is up-to-date.
#
# To use this hook, run the following command from the repository root:
#   git config core.hooksPath .githooks

set -eu

echo "Checking if uv.lock is synchronized..."

# Check without rewriting uv.lock. A lockfile mismatch or a failed uv command
# must stop the commit rather than allowing an unverified dependency change.
if ! uv lock --check; then
    echo "Error: uv.lock is out of sync with pyproject.toml, or uv could not verify it." >&2
    echo "Please run 'uv lock', stage the updated uv.lock, and re-commit." >&2
    exit 1
fi

echo "uv.lock is up to date."
