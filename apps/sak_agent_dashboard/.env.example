# Sak-Agent-Family Dashboard — environment
#
# With none of these set the dashboard reads ~/.sakthai directly (the local dev
# case) and, where that directory does not exist, serves the built-in sample
# dataset and says so in the header. Nothing here is required to boot.

# Runtime root the Python package uses. Only meaningful where the dashboard and
# the agent share a filesystem.
# SAKTHAI_HOME=/home/you/.sakthai

# Base URL of a running `sakthai web serve`. Set this on a hosted deploy
# (Vercel included): it is the only way a host with no ~/.sakthai can show live
# data. Must be reachable from the deployment, so a loopback address will not
# do — `sakthai web serve` refuses non-loopback binds unless
# SAKTHAI_WEB_ALLOW_PUBLIC is set, so put a tunnel or a reverse proxy in front.
# SAKTHAI_API_URL=https://agents.example.com

# Bearer token for that API, printed by `sakthai web setup`. Every path except
# /health requires it.
# SAKTHAI_API_TOKEN=

# Deprecated alias for SAKTHAI_HOME, still honoured.
# SAKTHAI_DIR=
