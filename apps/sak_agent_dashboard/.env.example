# Sak Agent Dashboard — local configuration.
# Copy to .env.local and edit. Every variable is optional; the defaults suit a
# standard local `sakthai` install. No secrets belong in .env.example itself.

# --- Agent artifacts -------------------------------------------------------
# Agent home the dashboard reads eval.jsonl / audit.log / sessions/ / memory.db
# from. Matches SAKTHAI_HOME on the Python side.
# SAKTHAI_DIR=/home/you/.sakthai

# spec-kit installation to introspect for the SpecKit panel. Resolved by default
# from the repo root (../../.specify relative to this app).
# SPECKIT_DIR=/home/you/Sak-Family-Agent/.specify

# --- Python web API bridge -------------------------------------------------
# Base URL of the `sakthai web` HTTP API, used by /api/stages and
# /api/ecosystem. Loopback-only unless SAKTHAI_WEB_ALLOW_PUBLIC is set on the
# server side. Leave unset to disable the bridge; those panels then report
# "unavailable" rather than falling back to demo data.
# SAKTHAI_WEB_URL=http://127.0.0.1:8765

# Bearer token for that API — every /api/* path there requires it (/health does
# not). Print or rotate it with `sakthai web setup` / `sakthai web regen-token`.
# Read server-side only; it is never sent to the browser.
# SAKTHAI_WEB_TOKEN=

# --- OpenTelemetry ---------------------------------------------------------
# OTLP/HTTP collector endpoint for the dashboard's own server spans. When unset,
# spans are written to a local file instead so the Traces tab still works with
# no collector running.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Service name stamped on emitted spans.
# OTEL_SERVICE_NAME=sak-agent-dashboard

# Set to 0 to disable dashboard instrumentation entirely.
# SAK_DASHBOARD_OTEL_ENABLED=1
