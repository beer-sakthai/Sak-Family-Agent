# Microsoft Entra ID (Azure AD) Settings
ENTRA_TENANT_ID=your-entra-tenant-id-or-common
ENTRA_AUDIENCE=api://your-domain.example
ENTRA_REQUIRED_SCOPE=Sak.Read

# Public Gateway Hostname (matching Caddy domain)
SAK_MCP_PUBLIC_HOST=mcp.your-domain.example

# Service Binding
HOST=0.0.0.0
PORT=8000

# Microsoft Work IQ MCP Endpoint
WORK_IQ_ENDPOINT=https://api.workiq.microsoft.com/mcp

# Set to true only in unit test / local development environments
MOCK_AUTH=false
