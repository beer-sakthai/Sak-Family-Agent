# Hermes runtime state — regenerated by the curator
skills/.bundled_manifest
skills/.curator_state
skills/.usage.json
skills/.usage.json.lock
__pycache__/
.hypothesis/
*.pyc
*.egg-info/
.venv/
# Ignore the legacy per-persona duplicate sakthai package copies, but keep the
# consolidated shared canonical (personas/shared/sakthai/) tracked — the five
# personas symlink to it, so it must exist in a fresh checkout (mirrors how
# personas/shared/agent-self-evolution/ is tracked).
personas/*/sakthai/
!personas/shared/sakthai/
!personas/shared/sakthai/**
# ...but never the regenerated Python caches inside it (the broad negation
# above would otherwise re-include them, overriding __pycache__/ and *.pyc).
personas/shared/sakthai/**/__pycache__/
personas/shared/sakthai/**/*.pyc

# HF cache directories
.hub/

# Agent self-evolution artifacts
personas/sakthai/agent-self-evolution/output/

# Root-level skills/ dir — conflicts with personas/*/skills/
/skills/
.coverage
