# Hermes runtime state — regenerated by the curator
skills/.bundled_manifest
skills/.curator_state
skills/.usage.json
skills/.usage.json.lock
__pycache__/
.hypothesis/
*.pyc
.venv/
# Legacy per-persona duplicate sakthai package copies. Scoped explicitly rather
# than with `personas/*/sakthai/`: that glob also matched
# personas/sakthai/sakthai/ — the package pyproject.toml installs — which made
# new modules there invisible to `git add`. personas/saktan/ was likewise fully
# ignored even though tests/test_soul_consistency.py reads its SOUL.md from
# disk. The consolidated shared canonical (personas/shared/sakthai/) stays
# tracked: the five personas symlink to it, so it must exist in a fresh
# checkout (mirrors how personas/shared/agent-self-evolution/ is tracked).
personas/sakjules/sakthai/
personas/sakking/sakthai/
personas/saksee/sakthai/
personas/saksit/sakthai/
personas/saktan/sakthai/
# ...but never the regenerated Python caches inside the shared copy.
personas/shared/sakthai/**/__pycache__/
personas/shared/sakthai/**/*.pyc

# HF cache directories
.hub/

# Agent self-evolution artifacts
personas/sakthai/agent-self-evolution/output/

# Root-level skills/ dir — conflicts with personas/*/skills/
/skills/
.coverage
coverage.xml
apps/*/node_modules
apps/*/.next
apps/*/.vercel
# Stray `next start`/`next build` console captures (one was committed in #1255).
apps/*/next_output.log
*.tsbuildinfo
.github/aw/

# Isolated workspaces for subagent-driven-development / plan execution
.worktrees/
.superpowers/

# Local secrets — never commit real credentials
.env
.env.local

# --- Generated runtime state -------------------------------------------------
# Hermes curator state, at the repo root and inside every persona skill tree.
# (The pre-existing `skills/.bundled_manifest` rules at the top of this file —
# and the identical ones in personas/sakthai/skills/.gitignore — are anchored to
# their own directory, so they only ever matched a `skills/skills/` path that
# does not exist. These replace them.)
**/.bundled_manifest
**/.curator_state
**/.usage.json
**/.usage.json.lock
**/.curator_backups/
**/*-.curator_backups/

# agent_workflow_framework per-run logs (root copy and the app's own dir).
.workflow_runs/

# HF scratch output — anchored to the root so these can never shadow a real
# data file of the same name deeper in the tree.
/ci_runs.json
/hf_dataset.json
/hf_ds_size.json
/hf_embed_check.json

# Large unreferenced branding assets — kept locally, not tracked
/assets/

# setuptools build metadata — regenerated by every editable install
*.egg-info/
