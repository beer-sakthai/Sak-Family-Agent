# Isolated execution environment for `sakthai run --sandbox`.
# run_command executes here — no host filesystem is mounted except memory.db.
#
# checkov:skip=CKV_DOCKER_2: Ephemeral task container, not a service — HEALTHCHECK is meaningless here
# checkov:skip=CKV_DOCKER_3: Runs as root so the bind-mounted memory.db keeps host-writable ownership
# Pinned by digest (Scorecard Pinned-Dependencies). The tag is kept alongside
# the digest so Dependabot's docker ecosystem can bump both together.
FROM python:3.14-slim@sha256:caaf356f40667c496d405780745b9ac25771c189a51dfcc42430d531ea09f8a2

# Common CLI tools that run_command is likely to need
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget jq unzip bash make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install sakthai (core only — no dashboard/e2e extras). The package sources
# live under personas/sakthai (see [tool.setuptools] in
# pyproject.toml), so mirror that layout inside the image.
COPY pyproject.toml README.md ./
COPY personas/sakthai/ ./personas/sakthai/
COPY library/ ./library/

# Copy standalone uv binary pinned by hash (Scorecard Pinned-Dependencies)
COPY --from=ghcr.io/astral-sh/uv:0.6.14@sha256:063d80d226a27e3661ebfdbe3a105f2c525fcf958994bb0f252bf46efea39b56 /uv /bin/uv
RUN uv pip install --system --no-cache -e "."

# Memory store mount point; host binds memory.db here at runtime
RUN mkdir -p /root/.sakthai

# Shell execution is safe inside the container — that is the whole point
ENV SAKTHAI_SHELL_ALLOW=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

ENTRYPOINT ["sakthai"]
