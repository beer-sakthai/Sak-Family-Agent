# Isolated execution environment for `sakthai run --sandbox`.
# run_command executes here — no host filesystem is mounted except memory.db.
#
# checkov:skip=CKV_DOCKER_2: Ephemeral task container, not a service — HEALTHCHECK is meaningless here
# checkov:skip=CKV_DOCKER_3: Runs as root so the bind-mounted memory.db keeps host-writable ownership
# Pinned by digest, not just tag, so a compromised or silently-republished
# `python:3.11-slim` cannot change what `sakthai run --sandbox` executes.
# Dependabot's docker ecosystem (.github/dependabot.yml) bumps this weekly.
FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4

# Common CLI tools that run_command is likely to need
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget jq unzip bash make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install sakthai (core only — no dashboard/e2e extras). The package sources
# live under personas/sakthai/sakthai (see [tool.setuptools.packages.find] in
# pyproject.toml), so mirror that layout inside the image.
#
# The uv binary comes from a digest-pinned image (0.12.5, multi-arch index), so
# no mutable tag can change what installs the project. The install itself is
# `uv sync --frozen`, which resolves exactly what uv.lock records and refuses
# to run if the lockfile drifts from pyproject.toml — this is what keeps
# Scorecard's PinnedDependenciesID quiet on the install step.
COPY --from=ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock README.md ./
COPY personas/sakthai/sakthai/ ./personas/sakthai/sakthai/
COPY library/ ./library/

RUN uv sync --frozen

# Memory store mount point; host binds memory.db here at runtime
RUN mkdir -p /root/.sakthai

# Shell execution is safe inside the container — that is the whole point
ENV SAKTHAI_SHELL_ALLOW=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:${PATH}"

ENTRYPOINT ["sakthai"]
