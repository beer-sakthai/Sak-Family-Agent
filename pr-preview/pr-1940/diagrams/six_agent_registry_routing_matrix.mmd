    subgraph RoutingMatrix ["🔄 Specialist Routing Matrix & Flows"]
        direction TB
        Flow_Web["data-request ──> SakSee<br/>monitoring-result (30m cache) ──> SakSit / Family"]
        Flow_Hub["Gate 1 info ──> SakSit (draft)<br/>hub-draft ──> Beer (review)<br/>hub-approved ──> SakThai (Triple Gate) ──> hub-complete"]
        Flow_Sched["schedule-request ──> SakJules<br/>schedule-confirmed ──> SakTan"]
        Flow_CI["ci-failure / stalled ──> SakJules<br/>PR verification & auto-heal ──> Family"]
        Flow_Conflict["conflict ──> SakThai (arbitration)"]
    end

    subgraph DeputyLadder ["🪜 Deputy Succession Ladder"]
