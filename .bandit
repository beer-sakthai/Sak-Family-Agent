# Bandit's project-level ini config.
#
# This file exists to make a *bare* `bandit -r .` behave — an editor
# integration, a pre-commit hook, or a third-party action that never passes
# `-c pyproject.toml`. Bandit discovers this file by walking the target tree and
# reads command-line defaults from it; it does not read `[tool.bandit]` in
# `pyproject.toml` unless `-c` names that file explicitly.
#
# The values below mirror `[tool.bandit]` in pyproject.toml, which stays the
# source of truth for the runs that matter (`ci.yml` and
# `.github/workflows/bandit.yml` both pass `-c pyproject.toml`). Keep the two in
# sync when either changes.
#
# What this replaced: a pasted fragment of GitHub Actions YAML
# (`uses: jpetrucciani/bandit-check@main`). Bandit found it, failed to parse it,
# and logged "Unable to parse config file ./.bandit or missing [bandit] section"
# on every run — so a bare invocation silently got no configuration at all.
#
# Bandit exits 2 if it finds more than one `.bandit` in the scanned tree. Keep
# this the only one.
[bandit]
# B101 assert_used            — pytest is built on assert
# B404 import_subprocess      — the agent shells out by design, behind guardrails
# B603 subprocess_without_shell_equals_true — argv lists, never shell strings
# B606 start_process_with_no_shell
# B607 start_process_with_partial_path
skips = B101,B404,B603,B606,B607

# Mirrors `exclude_dirs = ["tests"]`, plus the trees that are on disk but are
# not this repository's code to fix: vendored per-persona skill scripts, the
# curated third-party skill library, and the folded-in copy of the standalone
# sakthai-chat-cli repository. `.github/workflows/bandit.yml` passes the same
# set on the command line, where it wins over this file.
#
# The `./` prefix is load-bearing. Bandit matches an exclusion by plain
# substring (`any(x in path for x in excluded_path_strings)` in
# `bandit/core/manager.py`), so a bare `/build` also excludes
# `training/hf-jobs/build_toolcalling_dataset.py` — measured: 13 B311 findings
# in that one file vanished before the prefix was added. `./build` can only
# match the directory at the root, which is what is meant.
exclude = ./tests,./apps/agent_workflow_framework/tests,./services/teams-copilot-mcp/tests,./library,./sakthai-chat-cli,./personas/sakthai/skills,./personas/sakking/skills,./personas/saksee/skills,./personas/saksit/skills,./personas/sakjules/skills,./personas/saktan/skills,./personas/shared/skills,./.venv,./node_modules,./build,./dist

# The two out-of-tree test suites are named individually because this key
# cannot express "any directory called tests". `pyproject.toml`'s
# `exclude_dirs = ["tests"]` does, which is why a `-c pyproject.toml` run and a
# bare run differed by exactly these 12 findings before they were added.
