{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "House of Sak Renovate configuration for dependency telemetry and updates",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies", "renovate"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": false
    }
  ]
}
